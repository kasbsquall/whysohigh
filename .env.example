# Copy to .env. With SAMPLE_MODE=true (the default) nothing below is needed:
# the agents run on recorded model and SQL responses in samples/cache/.
SAMPLE_MODE=true

# Record live responses into samples/cache/ (only when SAMPLE_MODE=false).
RECORD_SAMPLES=false

# Meterless Nightshift: Console > Connect > This computer.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=replace-with-your-runtime-token

# Zetaris running locally in Docker (zetaris-platform bundle).
ZETARIS_UI_URL=http://localhost:3000
ZETARIS_API_URL=http://localhost:8888/api/v1.0
ZETARIS_EMAIL=admin@zetaris.com
ZETARIS_PASSWORD=replace-with-your-password
ZETARIS_ORG_ID=1

# Household history database (infra/household-db). Use a long random value.
HOUSEHOLD_DB_PASSWORD=replace-with-a-long-random-password

# Public data keys used by npm run setup:sources. DEMO_KEY is used when empty,
# but it is rate limited per IP. Free keys: api.data.gov/signup (OpenEI URDB)
# and eia.gov/opendata/register.php (EIA).
OPENEI_API_KEY=
EIA_API_KEY=
